{
	"schemaVersion": 1,
	"id": "huddable",
	"version": "${version}",
	"name": "Huddable",
	"description": "Move, scale and hide every part of your HUD in an in-game editor. Works with vanilla elements and other mods' HUDs, with layout profiles you can share as codes.",
	"authors": [
		"Tad"
	],
	"license": "GPL-3.0-only",
	"icon": "assets/huddable/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"uk.toakan.tad.huddable.HuddableClient"
		],
		"modmenu": [
			"uk.toakan.tad.huddable.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"huddable.mixins.json",
		"huddable.meowdding.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
