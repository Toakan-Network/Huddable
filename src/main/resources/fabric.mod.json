{
	"schemaVersion": 1,
	"id": "huddable",
	"version": "${version}",
	"name": "Huddable",
	"description": "Move, scale, hide and restyle the vanilla HUD in game. Drag health, hunger, the hotbar, the scoreboard and more where you want them, switch layout profiles, and share layouts as codes. Client-side; works on any server.",
	"authors": [
		"Tad"
	],
	"license": "GPL-3.0-only",
	"icon": "assets/huddable/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"uk.toakan.tad.huddable.HuddableClient"
		],
		"modmenu": [
			"uk.toakan.tad.huddable.compat.ModMenuCompat"
		]
	},
	"mixins": [
		"huddable.mixins.json",
		"huddable.meowdding.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": ">=0.161.0"
	},
	"suggests": {
		"modmenu": "*"
	}
}
